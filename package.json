{
  "name": "gemtd",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "simulate": "esbuild scripts/simulate.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/sim.mjs --log-level=warning && node node_modules/.cache/sim.mjs",
    "features-test": "esbuild scripts/features-test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/features.mjs --log-level=warning && node node_modules/.cache/features.mjs",
    "determinism-test": "esbuild scripts/determinism-test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/determinism.mjs --log-level=warning && node node_modules/.cache/determinism.mjs",
    "ai-test": "esbuild scripts/ai-test.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/ai-test.mjs --log-level=warning && node node_modules/.cache/ai-test.mjs",
    "bot-golden": "esbuild scripts/bot-golden.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/golden.mjs --log-level=warning && node node_modules/.cache/golden.mjs",
    "render-smoke": "esbuild scripts/render-smoke.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/render.mjs --log-level=warning && node node_modules/.cache/render.mjs",
    "versus-test": "esbuild scripts/versus-test.ts --bundle --platform=node --format=esm --external:peerjs --outfile=node_modules/.cache/versus.mjs --log-level=warning && node node_modules/.cache/versus.mjs"
  },
  "devDependencies": {
    "typescript": "5.4.5",
    "vite": "5.2.11"
  },
  "dependencies": {
    "peerjs": "1.5.4"
  }
}
